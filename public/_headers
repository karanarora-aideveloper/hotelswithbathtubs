# Cloudflare Pages Caching & Security Headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Next.js static asset chunks - 1 year immutable edge & browser caching
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Static public files & images
/images/*
  Cache-Control: public, max-age=2592000, immutable
/locations.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/search-data.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/matchmaker-data.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate
/sitemap-images.xml
  Cache-Control: public, max-age=0, must-revalidate
/favicon.ico
  Cache-Control: public, max-age=604800

# HTML responses - fresh revalidation so clients always get current build chunk hashes
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
