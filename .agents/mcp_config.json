{
  "mcpServers": {
    "chrome-mcp": {
      "command": "node",
      "args": [
        "/Users/karanarora/mcp-chrome-bridge/node_modules/mcp-chrome-bridge/dist/mcp/mcp-server-stdio.js"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "telegram-mcp": {
      "command": "/Users/karanarora/.local/bin/uv",
      "args": [
        "--directory",
        "/Users/karanarora/telegram-mcp",
        "run",
        "main.py"
      ],
      "env": {
        "TELEGRAM_API_ID": "YOUR_API_ID",
        "TELEGRAM_API_HASH": "YOUR_API_HASH",
        "TELEGRAM_SESSION_STRING": "YOUR_SESSION_STRING"
      }
    },
    "ui-expert": {
      "command": "node",
      "args": [
        "/Users/karanarora/ui-expert-mcp/dist/index.js"
      ]
    },
    "webclone": {
      "command": "/Users/karanarora/.local/bin/uv",
      "args": [
        "--directory",
        "/Users/karanarora/webclone",
        "run",
        "webclone-mcp.py"
      ]
    }
  }
}
