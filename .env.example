# Admin (local only; /admin is stashed from the static build)
ADMIN_USER=
ADMIN_PASS=

# Optional tooling
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
DEEPSEEK_API_KEY=
